# ── 힉스필드 (https://cloud.higgsfield.ai → API Keys) ──
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# 5초 지원 모델 (standard가 기본, 더 좋은 품질은 pro)
HF_MODEL=kling-video/v2.5-turbo/standard/image-to-video

# ── 인스타그램 (통합 로그인 Unified Login 토큰) ──
IG_ACCESS_TOKEN=
# 비워두면 토큰으로 자동 조회
IG_USER_ID=
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v27.0
# 1이면 게시물에 'AI 생성' 라벨 표시
IG_AI_LABEL=1

# ── 텔레그램 봇 (선택 · 비워두면 꺼짐) ──
# @BotFather 에서 /newbot 으로 받은 토큰
TG_BOT_TOKEN=
# 사용을 허용할 chat id (쉼표로 여러 개). 봇에게 /start 를 보내면 알려 줌
TG_CHAT_IDS=
# 1이면 웹에서 시작한 작업도 텔레그램으로 알림
TG_NOTIFY_WEB=1

# ── 팀 영상 합치기 (선택) ──
# 비워두면 자동 (npm 으로 설치된 ffmpeg → 시스템 ffmpeg 순)
FFMPEG_PATH=

# ── 앱 ──
PORT=3000
# 1이면 실제 API를 부르지 않고 흐름만 연습 (과금·게시 없음)
MOCK=0
